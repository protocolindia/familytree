// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedTrees  Tree[]       @relation("TreeOwner")
  permissions Permission[]
}

model Tree {
  id          String   @id @default(cuid())
  name        String                       // Telugu name
  nameEn      String                       // English name
  description String?
  visibility  String   @default("private") // "public" | "private"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User         @relation("TreeOwner", fields: [ownerId], references: [id])
  ownerId     String
  persons     Person[]
  permissions Permission[]
}

model Person {
  id         String   @id @default(cuid())
  name       String                      // Telugu name
  nameEn     String                      // English name
  gender     String   @default("male")   // "male" | "female"
  birth      String?
  death      String?
  education  String?
  occupation String?
  notes      String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tree       Tree           @relation(fields: [treeId], references: [id], onDelete: Cascade)
  treeId     String

  // Relationships where this person is the parent
  parentRels Relationship[] @relation("Parent")
  // Relationships where this person is the child
  childRels  Relationship[] @relation("Child")
}

model Relationship {
  id       String @id @default(cuid())
  relType  String // "son","daughter","wife","husband","brother","sister","ex-wife","ex-husband"...

  parent   Person @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String
  child    Person @relation("Child",  fields: [childId],  references: [id], onDelete: Cascade)
  childId  String

  @@unique([parentId, childId, relType])
}

model Permission {
  id     String @id @default(cuid())
  role   String // "admin" | "viewer"

  user   User   @relation(fields: [userId],  references: [id], onDelete: Cascade)
  userId String
  tree   Tree   @relation(fields: [treeId],  references: [id], onDelete: Cascade)
  treeId String

  @@unique([userId, treeId])
}
