generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("USER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedTrees  Tree[]       @relation("TreeOwner")
  permissions Permission[]
}

model Tree {
  id          String   @id @default(cuid())
  name        String
  nameEn      String
  description String?
  visibility  String   @default("private")
  treeData    String?                       // JSON: stores persons + rootNode
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User         @relation("TreeOwner", fields: [ownerId], references: [id])
  ownerId     String
  persons     Person[]
  permissions Permission[]
}

model Person {
  id         String   @id @default(cuid())
  name       String
  nameEn     String
  gender     String   @default("male")
  birth      String?
  death      String?
  education  String?
  occupation String?
  notes      String?
  photoUrl   String?
  spouseId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tree       Tree           @relation(fields: [treeId], references: [id], onDelete: Cascade)
  treeId     String
  parentRels Relationship[] @relation("Parent")
  childRels  Relationship[] @relation("Child")
}

model Relationship {
  id       String @id @default(cuid())
  relType  String

  parent   Person @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String
  child    Person @relation("Child",  fields: [childId],  references: [id], onDelete: Cascade)
  childId  String

  @@unique([parentId, childId, relType])
}

model Permission {
  id     String @id @default(cuid())
  role   String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  tree   Tree   @relation(fields: [treeId], references: [id], onDelete: Cascade)
  treeId String

  @@unique([userId, treeId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Village {
  id         String   @id @default(cuid())
  name       String   @unique
  teluguName String
  createdAt  DateTime @default(now())
}

model Surname {
  id         String   @id @default(cuid())
  name       String   @unique
  teluguName String
  createdAt  DateTime @default(now())
}
